{
  "name": "playtogether",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:https": "vite --host 0.0.0.0 --port 5173 --mode https",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app/api lib/server lib/island db tests scripts/check-migrations.mjs scripts/check-worker-size.mjs vitest.config.ts vite.config.ts drizzle.config.ts",
    "format:check": "prettier --check app/api lib/server lib/island db tests scripts/check-migrations.mjs scripts/check-worker-size.mjs vitest.config.ts vite.config.ts drizzle.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run db:verify && npm test && npm run build && npm run size",
    "db:verify": "drizzle-kit check && node scripts/check-migrations.mjs",
    "size": "node scripts/check-worker-size.mjs",
    "test:live": "vitest run tests/simulation/live.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.7.1",
    "@react-three/fiber": "^9.8.2",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.1",
    "three": "^0.187.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261124.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "wrangler": "4.167.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
